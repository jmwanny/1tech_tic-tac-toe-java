<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="613.0" prefWidth="363.0"
            style="-fx-background-color: #121212;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.tictactoegame.controllers.AILevelsController">

   <children>

      <ImageView fitHeight="613.0" fitWidth="363.0" pickOnBounds="true">
         <image>
            <Image url="@images/game-bg.png" />
         </image>
      </ImageView>

      <ImageView fitHeight="119.0" fitWidth="135.0" layoutX="119.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/tic-tac-toe-logo.png" />
         </image>
      </ImageView>

      <Label alignment="CENTER" layoutX="79.0" layoutY="159.0" prefHeight="49.0" prefWidth="198.0"
             style="-fx-font-family: 'Brick Sans'; -fx-text-fill: white; -fx-font-size:25px;
                      -fx-background-color: rgba(0, 255, 255, 0.07); -fx-background-radius: 15;"
             text="DIFFICULTY" />

      <Button id="easyButton" layoutX="79.0" layoutY="227.0" mnemonicParsing="false"
              prefHeight="49.0" prefWidth="198.0" onAction="#handleEasy"
              style="-fx-font-size:26; -fx-font-family:'Brick Sans'; -fx-background-radius:10;
                       -fx-background-color:#1E1E1E; -fx-text-fill:white; -fx-border-color:#00EAFF;
                       -fx-border-radius:10; -fx-border-width:2;"
              text="Easy" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Button>

      <Label layoutX="128.0" layoutY="290.0" style="-fx-text-fill: #00EAFF; -fx-font-style: italic;"
             text="Play with an easy AI." />

      <Button id="mediumButton" layoutX="79.0" layoutY="322.0" mnemonicParsing="false"
              prefHeight="49.0" prefWidth="198.0" onAction="#handleMedium"
              style="-fx-background-radius:10; -fx-border-color:#00EAFF; -fx-border-radius:10;
                       -fx-border-width:2; -fx-font-size:26; -fx-background-color:#1E1E1E;
                       -fx-font-family:'Brick Sans';"
              text="Medium" textFill="white">
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Button>

      <Label layoutX="112.0" layoutY="384.0" style="-fx-text-fill: #00EAFF; -fx-font-style: italic;"
             text="Play with a medium skilled AI." />

      <Button id="hardButton" layoutX="79.0" layoutY="427.0" mnemonicParsing="false"
              prefHeight="49.0" prefWidth="198.0" onAction="#handleHard"
              style="-fx-background-radius:10; -fx-border-color:#00EAFF; -fx-font-size:26; -fx-border-radius:10;
                       -fx-border-width:2; -fx-background-color:#1E1E1E; -fx-font-family:'Brick Sans';"
              textFill="white" text="Hard">
         <cursor>
            <Cursor fx:constant="OPEN_HAND" />
         </cursor>
      </Button>


      <Label layoutX="79.0" layoutY="490.0" style="-fx-text-fill: #00EAFF; -fx-font-style: italic;"
             text="Challenge the AI and test your Strategy!" />
      
      <Label layoutX="95.0" layoutY="582.0" style="-fx-text-fill: #00EAFF;"
             text="Made by JAM Tech - Version 1.0" />

   </children>
</AnchorPane>
